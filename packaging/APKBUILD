# Contributor: Bolt J Woofson <bolt@boop.no>
# Maintainer: Bolt J Woofson <bolt@boop.no>
pkgname=commanderdog
pkgver=0.2.9
pkgrel=0
pkgdesc="Multi-Tab Web Commander - By Woofson"
url="https://github.com/Woofson/commanderdog"
arch="x86_64 aarch64"
license="MIT"
depends="ca-certificates libssh2 sqlite-libs"
makedepends="cargo rust openssl-dev libssh2-dev sqlite-dev"
subpackages="$pkgname-doc"
source="$pkgname-$pkgver.tar.gz::https://github.com/Woofson/commanderdog/archive/refs/tags/v$pkgver.tar.gz"
builddir="$srcdir/$pkgname-$pkgver"

build() {
    cargo build --release --locked
}

check() {
    cargo test --release
}

package() {
    install -Dm755 target/release/commanderdog "$pkgdir"/usr/local/bin/commanderdog
    install -d "$pkgdir"/etc/commanderdog/conf.d
    install -m644 conf.d/*.toml "$pkgdir"/etc/commanderdog/conf.d/
    install -Dm644 LICENSE "$pkgdir"/usr/share/licenses/$pkgname/LICENSE
    install -Dm644 README.md "$pkgdir"/usr/share/doc/$pkgname/README.md
}
